    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# for data cleaning: combo (regex)\n",
    "import re"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Data Cleaning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _replace_multi(string, to_replace):\n",
    "    '''\n",
    "    to_replace : dict\n",
    "    \n",
    "    All keys in lower case. Each key matched at max once.\n",
    "    '''\n",
    "    for old_value, new_value in to_replace.items():\n",
    "        if old_value in string:\n",
    "            string = string.replace(old_value, new_value, 1)\n",
    "    return string"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _value_reclassify(string, to_reclassify):\n",
    "    '''\n",
    "    to_reclassify : dict\n",
    "\n",
    "    Each key matched at max once.\n",
    "    '''\n",
    "    for k, v in to_reclassify.items():\n",
    "        if k in string:\n",
    "            return v\n",
    "    return ''"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1) Clean: location"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _clean_location(df):\n",
    "    #Assign location with value \"0\" to \"Others\". For exact_course_name does not contain \"trip\" and \"Deep Learning\" and \"Free\", classify them all under Online instead of others    \n",
    "    return ['BT' * ('BT' in course or 'Bukit Timah' in course) or\n",
    "            'TP' * ('Tamp' in course) +\n",
    "            'MP' * (('MP' in course or 'Marine Parade' in course) and 'MP/' not in course) +\n",
    "            'Bishan' * ('Bishan' in course) or\n",
    "            'Others' * ('Deep Learning' in course or 'trip' in course or 'Free' in course and location == '0') or\n",
    "            'Online' * ('Deep Learning' not in course or 'trip' not in course or 'Free' not in course and location == '0')\n",
    "            for course, location in zip(df.exact_course_name, df.location)]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2) Clean: course_name"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _clean_course_name(df):\n",
    "    to_reclassify1 = {'pygame': 'Pygame', 'level compu': 'O Level Computing', 'master c': 'Junior Master Class', '1(html': 'Web Programming 1', '2(html': 'Web Programming 2', 'basics1': 'Basics 1', '11-18yr': 'Python: Online Open House'}\n",
    "    to_reclassify2 = {'principles+ 1': 'Principles 1', 'principles+ 2': 'Principles 2'}\n",
    "    to_replace = {\"(\": \"\", \")\": \"\", \"- Design\": \"Design\", \"uting1\": \"uting 1\", \"e pro\": \"e Pro\"}\n",
    "\n",
    "    return [_value_reclassify(exact_course, to_reclassify1) +\n",
    "            _value_reclassify(course.lower(), to_reclassify2) +\n",
    "            f'Principles X: {_replace_multi(course[13:], to_replace)}' * ('principles x' in course.lower()) or\n",
    "            course\n",
    "            for exact_course, course in zip(df.exact_course_name.str.lower(), df.course_name.str.strip())]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3) Clean: category"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pygame --> Principles, Web Programming --> Principles, O Level Computing --> Academics, Junior Master Class --> Others\n",
    "def _clean_category(df):\n",
    "    return ['Principles' * ('pygame' in course_cleaned or 'b pro' in course_cleaned) +\n",
    "            'Academics' * ('level compu' in course_cleaned) +\n",
    "            'Others' * (('master c' in course_cleaned or 'n:' in course_cleaned) or (category == 'Workshop' or category == 'Trip')) +\n",
    "            'Basics' * (course_cleaned == 'basics 1' and category == '0') or\n",
    "            category\n",
    "            for category, course_cleaned in zip(df.category, df.course_name.str.lower())]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4) Clean: course_format"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 0, Trip, Workshop --> Camp, Weekly, Others\n",
    "def _clean_course_format(df):\n",
    "    # calculate course duration\n",
    "    course_duration = (df.event_end_date - df.event_start_date).dt.days + 1\n",
    "\n",
    "    # 0, Open House, Trip, Workshop --> Weekly, Camp, Others\n",
    "    to_reclassify = ('0', 'Open House', 'Trip', 'Workshop')\n",
    "\n",
    "    return ['Weekly' *  (duration > 30 and course_format in to_reclassify) +\n",
    "            'Camp' * ((3 <= duration <= 30) and course_format in to_reclassify) +\n",
    "            'Others' * (duration < 3 and course_format in to_reclassify) or\n",
    "            course_format\n",
    "            for course_format, duration in zip(df.course_format, course_duration)]"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5-6) Clean: Transfer & Combo"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Transfer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
