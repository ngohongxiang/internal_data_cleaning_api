   "source": [
    "#### Merge & Transform (Main): Transferred, Combo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "metadata": {},
   "outputs": [],
   "source": [
    "def _clean_transferred_combo(df):\n",
    "    dict_get_rev = _clean_get_transferred(df[['comments', 'order_id', 'gross_revenue', 'ticket_revenue', 'pre_gst_revenue', 'gst', 'discount']])\n",
    "    dict_get_combo, dict_combo_zero = _clean_get_combo(df[['ticket_class_name', 'order_id', 'anon_purchaser_name', 'course_name', 'gross_revenue', 'ticket_revenue', 'pre_gst_revenue', 'gst', 'discount']])\n",
    "    \n",
    "    # {move rev to transaction, set original transaction rev to 0, set original combo transaction rev, bundled transactions}\n",
    "    dict_transferred_combo = {**{k: v[:-1] for k, v in dict_get_rev.items()}, **{v[-1]: [0] * 5 for v in dict_get_rev.values()},\n",
    "                              **{v[-1]: v[-6:-1] for v in dict_get_combo.values()}, **{k: v[-5:] for k, v in dict_combo_zero.items()}}\n",
    "    \n",
    "    return np.array([dict_transferred_combo.get(order_id) or (gRev, tRev, pRev, gst, discount)\n",
    "                     for order_id, gRev, tRev, pRev, gst, discount\n",
    "                     in zip(df.order_id, df.gross_revenue, df.ticket_revenue, df.pre_gst_revenue, df.gst, df.discount)])"
   ]
  },
  {
